    {
      "parameters": {
        "jsCode": "const fields = $json.body?.data?.fields || [];\nconst data = $json.body?.data || {};\n\nconst getField = (label) => fields.find(f => f.label === label);\n\nconst getValue = (label) => {\n  const field = getField(label);\n  return field?.value ?? \"\";\n};\n\nconst getChoiceText = (label) => {\n  const field = getField(label);\n  if (!field) return \"\";\n\n  const selectedId = Array.isArray(field.value) ? field.value[0] : field.value;\n  const selectedOption = field.options?.find(option => option.id === selectedId);\n\n  return selectedOption?.text ?? \"\";\n};\n\nconst normalizePhone = (value) => {\n  let phone = String(value || \"\").trim();\n\n  phone = phone\n    .replace(/^\"+|\"+$/g, \"\")\n    .replace(/[^\\d+]/g, \"\")\n    .replace(/(?!^)\\+/g, \"\");\n\n  if (phone.startsWith(\"+4949\")) {\n    phone = \"+49\" + phone.slice(5);\n  }\n\n  return phone;\n};\n\nreturn [\n  {\n    json: {\n      name: String(getValue(\"Name\")).trim(),\n      email: String(getValue(\"E-Mail-Adresse\")).trim().toLowerCase(),\n      phone: normalizePhone(getValue(\"Telefonnummer\")),\n      position: String(getValue(\"Gewünschte Position\")).trim(),\n      language: getChoiceText(\"Bevorzugte Kommunikationssprache\"),\n      tallySubmissionId: data.submissionId || \"\",\n      submissionPdfUrl: data.submissionPdfUrl || \"\",\n      submissionDate: data.createdAt || \"\"\n    }\n  }\n];"
      },
