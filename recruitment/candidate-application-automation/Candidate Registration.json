      "parameters": {
        "jsCode": "const data = $('Normalize Form 1 Data').first().json;\nconst now = new Date();\n\nconst candidateId =\n  'LCG-' +\n  now.getFullYear() +\n  String(now.getMonth() + 1).padStart(2, '0') +\n  String(now.getDate()).padStart(2, '0') +\n  '-' +\n  Date.now().toString().slice(-6);\n\nreturn {\n  ...data,\n  candidateId,\n  status: 'Erstkontakt',\n  createdAt: now\n  .toLocaleString(\"de-DE\", {\n    timeZone: \"Europe/Berlin\",\n    day: \"2-digit\",\n    month: \"2-digit\",\n    year: \"numeric\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n    second: \"2-digit\",\n    hour12: false\n  })\n  .replace(\",\", \"\")\n};"
      },
