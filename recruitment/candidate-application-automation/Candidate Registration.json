      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst detailFormUrl =\n  'https://tally.so/r/YOUR_FORM_ID'\n  + '?candidateId=' + encodeURIComponent(item.CandidateID)\n  + '&name=' + encodeURIComponent(item.Name)\n  + '&email=' + encodeURIComponent(item.Email)\n  + '&phone=' + encodeURIComponent(item.Phone)\n  + '&position=' + encodeURIComponent(item.Position)\n  + '&language=' + encodeURIComponent(item.Language);\n\nreturn [\n  {\n    json: {\n      ...item,\n      detailFormUrl,\n    },\n  },\n];"
      },
