      "id": "593920bb-407d-4800-ae1c-920a83f87973",
      "name": " Receive Candidate Details",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const trusted = $('Find Candidate Record').first().json;\nconst form2 = $('Normalize Form 2 Data').first().json;\n\n// Salary formatting (accepts: 58000, 58.000, 58.000 €, €58.000, €72,000, 72000 €)\nconst rawSalary = String(form2.salaryExpectation || \"\").trim();\n\nconst cleanedSalary = rawSalary\n  .replace(/[€\\s]/g, \"\")\n  .replace(/\\./g, \"\")\n  .replace(/,/g, \"\");\n\nconst salaryNumber = Number(cleanedSalary);\n\nconst salaryFormatted = Number.isFinite(salaryNumber) && salaryNumber > 0\n  ? new Intl.NumberFormat(\"de-DE\").format(salaryNumber) + \" €\"\n  : rawSalary;\n\nconst experienceNumber = Number(form2.experienceYears || 0);\n\nconst experienceFormatted = experienceNumber === 1\n  ? \"1 Jahr\"\n  : experienceNumber\n    ? `${experienceNumber} Jahre`\n    : \"\";\n\nconst generationDate = new Date().toLocaleDateString(\"de-DE\");\n\nconst submissionDate = form2.submittedAt\n  ? new Date(form2.submittedAt).toLocaleDateString(\"de-DE\")\n  : \"\";\n\nreturn [\n  {\n    json: {\n      // Trusted Form 1 data from Google Sheets only\n      candidateId: trusted.CandidateID,\n      name: trusted.Name,\n      email: trusted.Email,\n      phone: String(trusted.Phone || \"\"),\n      position: trusted.Position,\n      language: trusted.Language,\n\n      // Workflow configuration\n      hrEmail: \"hr@example.com\",\n\n      // Form 2 details\n      salary: form2.salaryExpectation || \"\",\n      salaryFormatted,\n      startDate: form2.startDate || \"\",\n      experience: form2.experienceYears || \"\",\n      experienceFormatted,\n      motivation: form2.motivation || \"\",\n\n      // CV / submission info\n      cv: form2.cvUrl || \"\",\n      cvFileName: form2.cvFileName || \"Lebenslauf\",\n      cvFileType: form2.cvFileType || \"Datei\",\n      submissionDate,\n\n      tallySubmissionId: form2.tallySubmissionId || \"\",\n      submissionPdfUrl: form2.submissionPdfUrl || \"\",\n      generationDate\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
