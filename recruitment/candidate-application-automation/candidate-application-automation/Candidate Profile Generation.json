{
  "name": "Candidate Profile Generation",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const fields = $json.body?.data?.fields || [];\nconst data = $json.body?.data || {};\n\nfunction getField(label) {\n  return fields.find(f => f.label === label);\n}\n\nfunction getValue(label) {\n  const field = getField(label);\n  if (!field) return \"\";\n\n  if (field.type === \"FILE_UPLOAD\") {\n    return field.value?.[0]?.url ?? \"\";\n  }\n\n  return field.value ?? \"\";\n}\n\nconst cvField = getField(\"Lebenslauf hochladen\");\nconst cvFile = cvField?.value?.[0] ?? null;\n\nreturn [\n  {\n    json: {\n      // Only used to find/validate trusted candidate row\n      candidateId: String(getValue(\"candidateId\")).trim(),\n      email: String(getValue(\"email\")).trim().toLowerCase(),\n\n      // Form 2 data only\n      salaryExpectation: String(getValue(\"Gehaltsvorstellung\")).trim(),\n\n      startDate: (() => {\n        const value = String(getValue(\"Frühestmöglicher Eintrittstermin\")).trim();\n        if (!value) return \"\";\n\n        const d = new Date(value);\n        if (Number.isNaN(d.getTime())) return value;\n\n        return d.toLocaleDateString(\"de-DE\");\n      })(),\n\n      experienceYears: String(getValue(\"Berufserfahrung\")).trim(),\n      motivation: String(getValue(\"Kurzbeschreibung / Motivation\")).trim(),\n\n      // CV upload data\n      cvUrl: cvFile?.url || \"\",\n      cvFileName: cvFile?.name || \"\",\n      cvFileType: cvFile?.mimeType || \"\",\n      cvFileSize: cvFile?.size || \"\",\n\n      // Tally metadata\n      tallySubmissionId: data.submissionId || \"\",\n      submittedAt: data.createdAt || \"\",\n      submissionPreviewUrl: data.submissionPreviewUrl || \"\",\n      submissionPdfUrl: data.submissionPdfUrl || \"\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3264,
        784
      ],
      "id": "21b764f9-0f59-49ab-bfad-41a83b501054",
      "name": "Normalize Form 2 Data"
    },
