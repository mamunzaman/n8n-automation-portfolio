        "jsonBody": "={{\n(() => {\n  const data = $('Combine Form 1 + Form 2 Data').first().json;\n  const open = String.fromCharCode(123,123);\n  const close = String.fromCharCode(125,125);\n\n  return {\n    requests: Object.entries({\n      candidateId: data.candidateId,\n      generationDate: data.generationDate,\n      name: data.name,\n      email: data.email,\n      phone: String(data.phone || \"\"),\n      position: data.position,\n      language: data.language,\n      salaryFormatted: data.salaryFormatted,\n      startDate: data.startDate,\n      experienceFormatted: data.experienceFormatted,\n      motivation: data.motivation,\n      cvFileName: data.cvFileName,\n      cvFileType: data.cvFileType,\n      submissionDate: data.submissionDate\n    }).map(([k,v]) => ({\n      replaceAllText: {\n        containsText: {\n          text: open + k + close,\n          matchCase: true\n        },\n        replaceText: v ?? \"\"\n      }\n    }))\n  };\n})()\n}}",
