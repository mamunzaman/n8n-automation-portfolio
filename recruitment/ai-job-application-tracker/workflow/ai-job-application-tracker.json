      "id": "dc164c1b-e6c5-4375-836d-39f54896a7da",
      "name": "10A OpenAI - Extraction Model"
    },
    {
      "parameters": {
        "jsCode": "const aiResult =\n  $json.output && typeof $json.output === 'object'\n    ? $json.output\n    : $json;\n\nconst source = $('08A Code - Prepare PDF Text').item.json;\n\nconst clean = (value) =>\n  String(value ?? '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\nconst normalizeKey = (value) =>\n  clean(value)\n    .normalize('NFKD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .toLowerCase()\n    .replace(/\\b(gmbh|ag|ug|se|kg|mbh|ltd|limited|inc)\\b/g, '')\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/^-+|-+$/g, '');\n\nconst company = clean(aiResult.company);\nconst position = clean(aiResult.position);\n\nreturn [\n  {\n    json: {\n      applicationKey: `${normalizeKey(company)}__${normalizeKey(position)}`,\n      company,\n      position,\n\n      sourceFileName: source.sourceFileName || '',\n      dropboxFileId: source.dropboxFileId || '',\n      dropboxRevision: source.dropboxRevision || '',\n      dropboxVersionKey: `${source.dropboxFileId || ''}:${source.dropboxRevision || ''}`,\n      dropboxPath: source.dropboxPath || '',\n      fileType: source.fileType || 'PDF',\n      processedAt: new Date().toISOString(),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
