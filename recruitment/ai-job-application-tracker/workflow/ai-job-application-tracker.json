    {
      "parameters": {
        "jsCode": "const text = String($json.text || '')\n  .replace(/\\u0000/g, '')\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/[ \\t]+/g, ' ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nconst file = $('05 Loop - Process Files One by One').item.json;\n\nreturn [\n  {\n    json: {\n      documentText: text,\n      textLength: text.length,\n      extractionSuccessful: text.length >= 100,\n\n      sourceFileName: file.name || '',\n      dropboxFileId: file.id || '',\n      dropboxRevision: file.rev || '',\n      dropboxPath: file.pathDisplay || file.pathLower || '',\n      lastModifiedServer: file.lastModifiedServer || '',\n      fileType: 'PDF',\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4624,
        2000
      ],
      "id": "2322c241-f8ef-4e3b-9f38-1807d7645f63",
      "name": "08A Code - Prepare PDF Text"
    },
    {
